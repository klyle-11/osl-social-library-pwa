{
  "name": "osl-social-library-pwa",
  "version": "1.0.0",
  "description": "OSL - Offline Social Library: a Preact PWA that works offline on iOS and Android",
  "main": "server.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "esbuild src/app.jsx --bundle --minify --sourcemap --format=esm --target=es2020,safari15 --jsx=automatic --jsx-import-source=preact --outfile=dist/app.js",
    "watch": "esbuild src/app.jsx --bundle --sourcemap --format=esm --target=es2020,safari15 --jsx=automatic --jsx-import-source=preact --outfile=dist/app.js --watch",
    "start": "node server.js",
    "start:https": "TLS_CERT=certs/cert.pem TLS_KEY=certs/key.pem HTTP_REDIRECT_PORT=8080 node server.js",
    "dev": "npm run build && node server.js",
    "cert": "sh scripts/dev-cert.sh",
    "icons": "python3 scripts/make-icons.py",
    "test": "node --test",
    "check": "tsc",
    "seed": "node scripts/seed.js",
    "build:site": "npm run build && node scripts/build-site.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klyle-11/osl-social-library-pwa.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/klyle-11/osl-social-library-pwa/issues"
  },
  "homepage": "https://github.com/klyle-11/osl-social-library-pwa#readme",
  "dependencies": {
    "nodemon": "^3.1.14",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
