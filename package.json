{
  "name": "osl-social-library-pwa",
  "version": "1.0.0",
  "description": "Offline Social Library: a local-first communal library PWA",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node scripts/build.mjs && node dist-node/server.mjs",
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "catalog": "node scripts/catalog.mjs",
    "check": "tsc -p . && tsc -p core && tsc -p app/tsconfig.sw.json",
    "test": "esbuild core/test/*.test.ts --bundle --platform=node --format=esm --outdir=.test-build --out-extension:.js=.mjs --log-level=warning && node --test .test-build/*.test.mjs",
    "cert": "node scripts/cert.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klyle-11/osl-social-library-pwa.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/klyle-11/osl-social-library-pwa/issues"
  },
  "homepage": "https://github.com/klyle-11/osl-social-library-pwa#readme",
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "nodemon": "^3.1.14",
    "preact": "^10.29.8",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
